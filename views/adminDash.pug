doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")

    title NYONDO ADMIN Dashboard

    link(rel="stylesheet" href="/css/admin.css")

  body
    aside
      h2 NYONDO ADMIN

      ul.nav-links
        li.active
          a(href="/adminDash") Dashboard

        li
          a(href="/SignUpform") Register

        li
          a(href="/salesDash") Sales

        li
          a(href="/stockDash") Stock
        
        li
          a(href="/users") user table

        li 
          a(href="/reports") 📊 Reports

        li 
          a(href="/supplierTable") SupplierTable

        li
          a(href="/salary") Deposit

        li
          a(href="/logout") Logout
      
    main
      .navbar
        div
          strong NYONDO GENERAL HARDWARE LTD

        div
          strong Logged in as Administrator

        #clock

      // kpi (key importance indicator cards)
      .kpi-grid
        .kpi-card
          h4 Total Sales (Cash)
          p UGX #{Number(totalCashSales || 0).toLocaleString()}

        .kpi-card
          h4 Total Credit Sales
          p UGX #{Number(totalCreditSales || 0).toLocaleString()}

        .kpi-card
          h4 Total Stock Value
          p UGX #{Number(totalStockValue || 0).toLocaleString()}

        .kpi-card
          h4 Suppliers Owed
          p #{suppliersOwed || 0} Suppliers

        .kpi-card
          h4 Low Stock Alerts
          p #{lowStockCount}

      // customer table
      .section-box
        h3 Customer Credit / Deposit Records

        table
          thead
            tr
              th Date
              th Customer
              th NIN
              th Phone
              th Address
              th Product Item
              th Qty
              th Total
              th Paid
              th Balance
              th Status
              th Receipt
              th Actions

          tbody
            if deposits && deposits.length
              each deposit in deposits
                if deposit.items && deposit.items.length > 0
                  each item, index in deposit.items
                    if index === 0
                      tr
                        td(rowspan=deposit.items.length)= deposit.createdAt ? new Date(deposit.createdAt).toLocaleDateString() : '-'
                        td(rowspan=deposit.items.length)
                          strong= deposit.customerName
                        td(rowspan=deposit.items.length)= deposit.ninNumber
                        td(rowspan=deposit.items.length)= deposit.customerPhone
                        td(rowspan=deposit.items.length)= deposit.customerAddress
                        
                        // First item row data content
                        td= item.itemName || 'N/A'
                        td(style="text-align: center")
                          strong= item.quantity || item.itemQuantity || 0
                        
                        td(rowspan=deposit.items.length) UGX #{Number(deposit.totalToPay || 0).toLocaleString()}
                        td(rowspan=deposit.items.length) UGX #{Number(deposit.amountPaid || 0).toLocaleString()}
                        td(rowspan=deposit.items.length) UGX #{Number(deposit.balance || 0).toLocaleString()}
                        
                        td(rowspan=deposit.items.length)
                          if deposit.paymentStatus === "Finished" || deposit.balance <= 0
                            span(style="color:green; font-weight:bold") Finished
                          else
                            span(style="color:red; font-weight:bold") Pending

                        // Receipt button 
                        td(rowspan=deposit.items.length)
                          a.btn.btn-green(
                            href=`/deposit/receipt/${deposit._id}`
                            target="_blank"
                          ) 🧾 Receipt

                        // Actions 
                        td(rowspan=deposit.items.length)
                          if deposit.balance > 0
                            div(style="display: flex; flex-direction: column; gap: 5px;")
                              a.btn.btn-blue(
                                href=`/deposit/edit/${deposit._id}`
                              ) Edit Deposit

                              form(
                                method="POST",
                                action=`/deposit/finish/${deposit._id}`,
                                style="margin:0;"
                              )
                                button.btn(type="submit" style="background-color:#ef4444; color:white; border:none; padding:5px 10px; border-radius:4px; cursor:pointer; width:100%;") Clear Debt
                          else
                            span Done
                    else
                      // Extra  purchases in the invoice block 
                      tr
                        td= item.itemName || 'N/A'
                        td(style="text-align: center")
                          strong= item.quantity || item.itemQuantity || 0

                else
                  // Fallback safely if a legacy document profile has a clean or unpopulated items array list
                  tr
                    td= deposit.createdAt ? new Date(deposit.createdAt).toLocaleDateString() : '-'
                    td
                      strong= deposit.customerName
                    td= deposit.ninNumber
                    td= deposit.customerPhone
                    td= deposit.customerAddress
                    td N/A
                    td(style="text-align: center") 0
                    td UGX #{Number(deposit.totalToPay || 0).toLocaleString()}
                    td UGX #{Number(deposit.amountPaid || 0).toLocaleString()}
                    td UGX #{Number(deposit.balance || 0).toLocaleString()}
                    td
                      if deposit.paymentStatus === "Finished" || deposit.balance <= 0
                        span(style="color:green; font-weight:bold") Finished
                      else
                        span(style="color:red; font-weight:bold") Pending
                    td
                      a.btn.btn-green(
                        href=`/deposit/receipt/${deposit._id}`
                        target="_blank"
                      ) 🧾 Receipt
                    td
                      if deposit.balance > 0
                        div(style="display: flex; flex-direction: column; gap: 5px;")
                          a.btn.btn-blue(
                            href=`/deposit/edit/${deposit._id}`
                          ) Edit Deposit

                          form(
                            method="POST",
                            action=`/deposit/finish/${deposit._id}`,
                            style="margin:0;"
                          )
                            button.btn(type="submit" style="background-color:#ef4444; color:white; border:none; padding:5px 10px; border-radius:4px; cursor:pointer; width:100%;") Clear Debt
                      else
                        span Done

            else
              tr
                td(
                  colspan="13",
                  style="text-align:center;color:#94a3b8"
                )
                  | No customer credit records available

    script.
      function updateClock() {
          const now = new Date();
          document.getElementById("clock").innerText =
              now.toLocaleTimeString();
      }

      setInterval(updateClock, 1000);

      updateClock();