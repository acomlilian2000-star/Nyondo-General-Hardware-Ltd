doctype html
html(lang="en")

  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")

    title NYONDO ADMIN Dashboard

    link(rel="stylesheet" href="/css/admin.css")

  body

    aside

      h2 NYONDO ADMIN

      ul.nav-links

        li.active
          a(href="/adminDash") Dashboard

        li
          a(href="/SignUpform") Register

        li
          a(href="/salesDash") Sales

        li
          a(href="/stockDash") Stock
        
        li
          a(href="/users") user table

        li 
          a(href="/reports") 📊 Reports

        li 
        
          a(href="/supplierTable") SupplierTable

        li
          a(href="/salary") Deposit

        li
          a(href="/logout") Logout
      
    main

      .navbar
        div
          strong NYONDO GENERAL HARDWARE LTD

        div
          strong Logged in as Administrator

        #clock

      // ================= KPI CARDS =================
      .kpi-grid

        .kpi-card
          h4 Total Sales (Cash)
          p UGX #{totalCashSales || 0}

        .kpi-card
          h4 Total Credit Sales
          p UGX #{totalCreditSales || 0}

        .kpi-card
          h4 Total Stock Value
          p UGX #{totalStockValue || 0}

        // ================= FIXED SUPPLIERS OWE LOGIC =================
        .kpi-card
          h4 Suppliers Owed
          p #{suppliersOwed || 0} Suppliers

        .kpi-card
          h4 Low Stock Alerts
          p #{lowStockCount}

      // ================= CUSTOMER TABLE =================
      .section-box

        h3 Customer Credit / Deposit Records

        table

          thead
            tr
              th Date
              th Customer
              th NIN
              th Phone
              th Address
              th Items
              th Total
              th Paid
              th Balance
              th Status
              th Receipt
              th Actions

          tbody

            if deposits && deposits.length

              each deposit in deposits

                tr

                  td= deposit.createdAt ? new Date(deposit.createdAt).toLocaleDateString() : '-'

                  td= deposit.customerName

                  td= deposit.ninNumber

                  td= deposit.customerPhone

                  td= deposit.customerAddress

                  // ================= SAFE ITEM DISPLAY =================
                  td
                    if deposit.items && deposit.items.length
                      = deposit.items.map(i => i.itemName).join(", ")
                    else
                      | N/A

                  td UGX #{deposit.totalToPay || 0}

                  td UGX #{deposit.amountPaid || 0}

                  td UGX #{deposit.balance || 0}

                  td
                    if deposit.paymentStatus === "Finished" || deposit.balance <= 0
                      span(style="color:green") Finished
                    else
                      span(style="color:red") Pending

                  // ================= RECEIPT BUTTON =================
                  td
                    a.btn.btn-green(
                      href=`/deposit/receipt/${deposit._id}`
                      target="_blank"
                    ) 🧾 Receipt

                  // ================= ACTIONS =================
                  td

                    if deposit.balance > 0

                      a.btn.btn-blue(
                        href=`/deposit/edit/${deposit._id}`
                      ) Edit Deposit

                      form(
                        method="POST",
                        action=`/deposit/finish/${deposit._id}`,
                        style="display:inline-block"
                      )
                        button(type="submit") Clear Debt

                    else

                      span Done

            else

              tr
                td(
                  colspan="12",
                  style="text-align:center;color:#94a3b8"
                )
                  | No customer credit records available

    script.
      function updateClock() {

          const now = new Date();

          document.getElementById("clock").innerText =
              now.toLocaleTimeString();
      }

      setInterval(updateClock, 1000);

      updateClock();