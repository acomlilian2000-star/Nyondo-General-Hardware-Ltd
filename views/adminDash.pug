doctype html
html(lang="en")

  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")

    title NYONDO ERP Dashboard

    // External CSS
    link(rel="stylesheet" href="/css/admin.css")

    //- // Font Awesome
    //- link(
    //-   href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    //-   rel="stylesheet"
    //- )

  body

    // ================= SIDEBAR =================
    aside

      h2 NYONDO ADMIN

      ul.nav-links

        li.active
          a(href="/adminDash")
            i.fa.fa-gauge
            |  Dashboard

        li
          a(href="/SignUpform")
            i.fa.fa-user-plus
            |  Register

        li
          a(href="/salesDash")
            i.fa.fa-cash-register
            |  Sales

        li
          a(href="/stockDash")
            i.fa.fa-box
            |  Stock

        li
          a(href="/salary")
            i.fa.fa-credit-card
            |  Deposit

        li
          a(href="/logout")
            i.fa.fa-right-from-bracket
            |  Logout

    // ================= MAIN CONTENT =================
    main

      // ================= NAVBAR =================
      .navbar

        div
          strong NYONDO GENERAL HARDWARE LTD

        div
          strong Logged in as Administrator

        #clock

      // ================= KPI CARDS =================
      .kpi-grid

        .kpi-card
          h4 Total Sales
          p UGX —

        .kpi-card
          h4 Total Stock Value
          p UGX —

        .kpi-card
          h4 Suppliers Owed
          p —

        .kpi-card
          h4 Low Stock Alerts
          p —

      // ================= CUSTOMER TABLE =================
      .section-box

        h3 Customer Credit / Deposit Records

        table

          thead
            tr
              th Customer Name
              th NIN Number
              th Phone
              th Address
              th Distance
              th Item Purchased
              th Total Amount
              th Transport Cost
              th Amount Paid
              th Balance
              th Status

          tbody

            tr
              td(
                colspan="11"
                style="text-align:center; color:#94a3b8;"
              )
                | No customer credit records available

    // ================= LIVE CLOCK =================
    script.
      function updateClock() {

          const now = new Date();

          document.getElementById("clock").innerText =
              now.toLocaleTimeString();

      }

      setInterval(updateClock, 1000);

      updateClock();