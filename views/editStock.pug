doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title NYONDO | Edit Stock Item

    // External CSS
    link(rel='stylesheet' href='/css/stock.css')
    
    style.
      .read-only-highlight { background-color: #f3f4f6; cursor: not-allowed; }

  body
    .form-container

      h1 NYONDO General Hardware LTD
      p.subtitle Edit Inventory Record: #{stockItem.itemName}

      // Dynamic action URL mapping the precise database item ID
      form#stockForm(action=`/stock/update/${stockItem._id}` method='POST')

        // ================= PRODUCTS CONTAINER =================
        #itemsContainer

          // ================= STOCK ITEM =================
          .stock-item

            .section-title Product Information

            .form-group
              label Product Name
              input.read-only-highlight(
                type='text'
                name='itemName'
                value=stockItem.itemName
                readonly
              )

            .input-row
              .form-group
                label Quantity
                input.quantity(
                  type='number'
                  name='quantity'
                  value=stockItem.quantity
                  placeholder='Enter Quantity'
                  required
                )

              .form-group
                label Unit Cost (UGX)
                input.unitCost(
                  type='number'
                  name='unitCost'
                  value=stockItem.unitCost
                  placeholder='Enter Unit Cost'
                  required
                )

            .input-row
              .form-group
                label Selling Price (UGX)
                input.unitPrice(
                  type='number'
                  name='unitPrice'
                  value=stockItem.unitPrice
                  placeholder='Selling Price'
                  required
                )
                p.helper-text Selling price must be greater than unit cost.

            // ================= SUPPLIER INFO =================
            .input-row
              .form-group
                label Supplier
                input(
                  type='text'
                  name='supplier'
                  value=stockItem.supplier || ''
                )

              .form-group
                label Contact Person
                input(
                  type='text'
                  name='contactPerson'
                  value=stockItem.contactPerson || ''
                )

        // ================= SUBMIT =================
        button.btn-submit(type='submit')
          | Save Changes

        .footer-text(style="margin-top: 20px; text-align: center;")
          a(href="/stockDash") ← Back to Dashboard

    script.
      // ================= VALIDATION =================
      document
        .getElementById('stockForm')
        .addEventListener('submit', function(e) {
          const cost = Number(document.querySelector('.unitCost').value);
          const price = Number(document.querySelector('.unitPrice').value);

          if (price <= cost) {
            e.preventDefault();
            alert('Selling price must be greater than Unit Cost.');
          }
        });