doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width,initial-scale=1")
    title NYONDO | Sales Attendant Dashboard

    link(rel="stylesheet" href="/css/salesDash.css")

  body

    nav.navbar
      .nav-left
        span NYONDO GENERAL HARDWARE

      .nav-center
        span Logged in as: Sales Attendant

      .nav-right
        span#datetime

        button(onclick="handleLogout()") LOGOUT

    .container

      .stats-grid

        .stat-card
          h3 My Sales Today
          p UGX #{totalSalesToday}

        .stat-card
          h3 Total Revenue
          p UGX #{dbSales.reduce((a, b) => a + (b.grandTotal || 0), 0)}

        .stat-card
          h3 low stock alert
          p ----

      .main-layout

        .content-left

          .section-box
            h3 📦 Sales Records

            table
              thead
                tr
                  th Date
                  th Product
                  th Image
                  th Specification
                  th Unit Price
                  th Quantity
                  th Customer Name
                  th Phone Number
                  th Address
                  th Customer Type
                  th Distance
                  th Transport Cost
                  th Sub Total
                  th Grand Total
                  th Payment Method
                  th Actions

              tbody
                if !dbSales || dbSales.length === 0
                  tr
                    td(colspan="16") No sales recorded yet

                else
                  each sale in dbSales
                    tr
                      td= sale.date ? new Date(sale.date).toLocaleDateString() : '-'

                      td= (sale.product && sale.product.itemName) ? sale.product.itemName : 'Deleted Product'

                      td
                        if sale.product && sale.product.image
                          img(src=sale.product.image, width="45", height="45")
                        else
                          span No Image

                      td= sale.specification || '-'
                      td= sale.unitPrice || 0
                      td= sale.quantity || 0
                      td= sale.customerName || '-'
                      td= sale.phoneNumber || '-'
                      td= sale.customerAddress || '-'
                      td= sale.customerType || '-'
                      td= sale.distance || 0
                      td= sale.transportCost || 0
                      td= sale.subTotal || 0
                      td= sale.grandTotal || 0
                      td= sale.paymentMethod || '-'

                      td
                        a.btn.btn-blue(href=`/sales/edit/${sale._id}`) Edit
                        a.btn.btn-red(href=`/sales/delete/${sale._id}` onclick="return confirm('Delete this sale?')") Delete
                        a.btn.btn-green(href=`/sales/mark-updated/${sale._id}` onclick="return confirm('Confirm update?')") Update

        .content-right

          .section-box
            h3 ⚡ Sales Quick Actions

            button.btn.btn-blue(type="button" onclick="goTo('/salesform')") 📝 New Sale

    script.
      function handleLogout() {
        if (confirm("Logout?")) {
          window.location.href = "/logout";
        }
      }

      function goTo(url) {
        window.location.href = url;
      }

      function updateTime() {
        const now = new Date();
        document.getElementById("datetime").innerText =
          now.toLocaleDateString() + " " + now.toLocaleTimeString();
      }

      setInterval(updateTime, 1000);
      updateTime();