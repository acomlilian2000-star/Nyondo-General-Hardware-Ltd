doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title NYONDO Stock Registration

    link(rel='stylesheet' href='/css/stock.css')

  body

    .form-container

      // ================= BACK BUTTON (NOW INSIDE FORM TOP) =================
      .top-bar(style='padding:10px;')
        button(type='button' onclick="window.location.href='/stockDash'" style='padding:8px 15px; cursor:pointer;')
          | ← Back to Dashboard

      h1 NYONDO General Hardware LTD
      p.subtitle Official Stock Arrival & Finance Portal

      // ================= BACKEND VALIDATION FLASH NOTIFICATIONS =================
      if success_msg && success_msg.length > 0
        div(style="background-color: #d1fae5; color: #065f46; padding: 12px 20px; border-radius: 4px; border-left: 5px solid #10b981; margin-bottom: 20px; font-weight: bold; font-size: 14px;")
          | #{success_msg}

      if error_msg && error_msg.length > 0
        div(style="background-color: #fee2e2; color: #991b1b; padding: 12px 20px; border-radius: 4px; border-left: 5px solid #ef4444; margin-bottom: 20px; font-weight: bold; font-size: 14px;")
          | #{error_msg}

      form#stockForm(action='/stock' method='POST' enctype='multipart/form-data')

        // ================= PRODUCTS CONTAINER =================
        #itemsContainer

          // ================= STOCK ITEM =================
          .stock-item

            .section-title Product Information

            .form-group
              label Product Name
              select.productSelect(name='itemName[]')
                option(value='' disabled selected) -- Select Product --

                optgroup(label='Construction Materials')
                  option(value='Cement CEM II' data-category='Construction Materials') Cement (CEM II)
                  option(value='Cement CEM III' data-category='Construction Materials') Cement (CEM III)
                  option(value='Iron Bars 10mm' data-category='Construction Materials') Iron Bars (10mm)
                  option(value='Iron Bars 12mm' data-category='Construction Materials') Iron Bars (12mm)
                  option(value='Iron Bars 16mm' data-category='Construction Materials') Iron Bars (16mm)

                optgroup(label='Fasteners & Tools')
                  option(value='Nails Assorted' data-category='Fasteners & Tools') Nails (Assorted)
                  option(value='Roofing Nails' data-category='Fasteners & Tools') Roofing Nails
                  option(value='Wheelbarrow' data-category='Fasteners & Tools') Wheelbarrow

                optgroup(label='Fencing & Roofing')
                  option(value='Barbed Wire' data-category='Fencing & Roofing') Barbed Wire
                  option(value='Wire Mesh' data-category='Fencing & Roofing') Wire Mesh
                  option(value='Iron Sheets' data-category='Fencing & Roofing') Iron Sheets

            .input-row
              .form-group
                label Category
                input.category(type='text' name='category[]' readonly)

            .input-row
              .form-group
                label Specification
                select(name='specification[]')
                  option(value='' disabled selected) -- Select Specification --
                  option(value='Pieces') Pieces
                  option(value='Kgs') Kilograms (Kgs)
                  option(value='Bags') Bags
                  option(value='Rolls') Rolls

            .input-row
              .form-group
                label Quantity
                input.quantity(type='number' name='quantity[]')

              .form-group
                label Unit Cost (UGX)
                input.unitCost(type='number' name='unitCost[]')

            .input-row
              .form-group
                label Selling Price (UGX)
                input.unitPrice(type='number' name='unitPrice[]')

            .input-row
              .form-group
                label Product Image
                input(type='file' name='productImage' accept='image/*')

        // ================= ADD ITEM BUTTON =================
        button#addItemBtn(type='button') + Add Another Product

        // ================= SUPPLIER INFO (ONLY ONCE) =================
        .section-title Supplier Information

        .input-row
          .form-group
            label Supplier
            select(name='supplier')
              option(value='' disabled selected) -- Select Supplier --
              option(value='Hima Cement') Hima Cement
              option(value='Tororo Cement') Tororo Cement
              option(value='China Depot') China Depot
              option(value='Uganda Baati') Uganda Baati
              option(value='Roofings Uganda') Roofings Uganda
              option(value='Hardware World') Hardware World
              option(value='Other') Other

          .form-group
            label Contact Person
            input(type='text' name='contactPerson')

        .input-row
          .form-group
            label Supplier Phone (+256)

            .phone-wrapper(style='display:flex; align-items:center; gap:5px;')
              span +256
              input(type='tel' name='supplierPhone')

          .form-group
            label Factory Name
            input(type='text' name='factoryName')

        // ================= PAYMENT =================
        .section-title Payment Information

        .payment-box
          .form-group
            label Payment Method
            select(name='paymentMethod')
              option(value='' disabled selected) -- Select Payment --
              option(value='cash') Cash
              option(value='credit') Credit

        // ================= SUBMIT =================
        button.btn-submit(type='submit') Complete Stock Entry


    script.

      const addItemBtn = document.getElementById('addItemBtn');
      const itemsContainer = document.getElementById('itemsContainer');

      addItemBtn.addEventListener('click', () => {

        const firstItem = document.querySelector('.stock-item');
        const clonedItem = firstItem.cloneNode(true);

        clonedItem.querySelectorAll('input').forEach(i => i.value = '');
        clonedItem.querySelectorAll('select').forEach(s => s.selectedIndex = 0);

        itemsContainer.appendChild(clonedItem);
      });

      document.addEventListener('change', function(e) {

        if (e.target.classList.contains('productSelect')) {

          const option = e.target.options[e.target.selectedIndex];
          const category = option.getAttribute('data-category');

          const parent = e.target.closest('.stock-item');
          const catInput = parent.querySelector('.category');

          if (catInput) catInput.value = category || '';
        }
      });