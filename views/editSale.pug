doctype html
html
  head
    title Edit Sale
    link(rel="stylesheet" href="/css/edit.css")

  body

    .container
      h2 Edit Sale

      form(action=`/sales/edit/${sale._id}` method="POST")

        // ================= CUSTOMER INFO =================
        .form-group
          label Customer Name
          input(type="text" name="customerName" value=sale.customerName)

        .form-group
          label Phone Number
          input(type="text" name="phoneNumber" value=sale.phoneNumber)

        .form-group
          label Address
          input(type="text" name="customerAddress" value=sale.customerAddress)

        // ================= MULTI ITEMS (FIXED PART) =================
        h3 Items

        #itemsContainer

          if sale.items && sale.items.length

            each item, i in sale.items

              .item-group

                .form-group
                  label Product

                  select(name="product[]" required)
                    option(value=item.product._id selected)
                      | #{item.product.itemName}

                .form-group
                  label Specification
                  input(type="text" name="specification[]" value=item.specification)

                .form-group
                  label Unit Price
                  input(type="number" name="unitPrice[]" value=item.unitPrice)

                .form-group
                  label Quantity
                  input(type="number" name="quantity[]" value=item.quantity)

          else

            p No items found

        // ================= DELIVERY =================
        .form-group
          label Distance
          input(type="number" name="distance" value=sale.distance)

        .form-group
          label Transport Cost
          input(type="number" name="transportCost" value=sale.transportCost)

        // ================= TOTALS =================
        .form-group
          label Sub Total
          input(type="number" name="subTotal" value=sale.subTotal readonly)

        .form-group
          label Grand Total
          input(type="number" name="grandTotal" value=sale.grandTotal readonly)

        // ================= PAYMENT =================
        .form-group
          label Payment Method
          select(name="paymentMethod")
            option(value="cash" selected=sale.paymentMethod === "cash") Cash
            option(value="mobile-money" selected=sale.paymentMethod === "mobile-money") Mobile Money
            option(value="bank-transfer" selected=sale.paymentMethod === "bank-transfer") Bank Transfer

        button(type="submit") Update Sale