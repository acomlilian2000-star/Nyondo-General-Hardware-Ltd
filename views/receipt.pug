doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Sales Receipt
    link(rel="stylesheet" href="/css/receipt.css")

  body

    .receipt
      h2 NYONDO GENERAL HARDWARE
      p.text-center Official Sales Receipt
      hr

      // ================= SALE INFO =================
      .row
        span Date:
        span= sale.date ? new Date(sale.date).toLocaleString() : '-'

      .row
        span Customer:
        span= sale.customerName || '-'

      .row
        span Phone:
        span= sale.phoneNumber || '-'

      .row
        span Address:
        span= sale.customerAddress || '-'

      .row
        span Attendant:
        span= sale.Attendant ? sale.Attendant.fullName : '-'

      .row
        span Distance:
        span= sale.distance || 0

      hr

      // ================= PRODUCTS =================
      h3 Products Sold

      if sale.items && sale.items.length
        each item in sale.items
          .item-box
            .row
              span Product:
              span= item.product ? item.product.itemName : 'Deleted Product'

            .row
              span Quantity:
              span= item.quantity || 0

            .row
              span Unit Price:
              span UGX #{item.unitPrice || 0}

            .row
              span Sub Total:
              span UGX #{item.subTotal || 0}

            hr
      else
        p No items found

      // ================= TOTALS =================
      .row
        span Transport:
        span UGX #{sale.transportCost || 0}

      .row
        strong Grand Total:
        strong UGX #{sale.grandTotal || 0}

      .row
        span Payment Method:
        span= sale.paymentMethod || '-'

      hr

      // ================= ACTIONS =================
      .receipt-actions
        button.print-btn(onclick="window.print()") Print Receipt

        a.back-btn(href="/salesform") Back To Sales Form

        a.dashboard-btn(href="/salesDash") Go To Dashboard

    // ================= AUTO PRINT =================
    script.
      window.onload = function () {
        setTimeout(() => window.print(), 500);
      };

      window.onafterprint = function () {
        window.location.href = "/salesDash";
      };