doctype html
html(lang="en")

  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")

    title NYONDO Receipt

    link(rel="stylesheet" href="/css/tempReceipt.css")

  body

    .receipt-container

      // ================= HEADER =================
      .receipt-header
        h1 NYONDO General Hardware LTD
        h2 Salary Earner Deposit Receipt
        p Nansana - Uganda

      hr

      // ================= CUSTOMER DETAILS =================
      .customer-section
        h3 Customer Information

        .details-grid

          .detail-box
            span.label Customer Name
            p= customer.customerName || '-'

          .detail-box
            span.label NIN Number
            p= customer.ninNumber || '-'

          .detail-box
            span.label Phone Number
            p= customer.customerPhone || customer.phoneNumber || '-'

          .detail-box
            span.label Registration Date
            p= customer.regDate ? new Date(customer.regDate).toLocaleDateString() : '-'

          .detail-box
            span.label Distance
            p #{customer.distance || 0} KM

      hr

      // ================= ITEMS TABLE =================
      .table-section
        h3 Purchased Items

        table
          thead
            tr
              th Item
              th Specification
              th Quantity
              th Unit Price
              th Total

          tbody
            if items && items.length
              each item in items
                tr
                  // ✅ FIXED: correct product name source
                  td= item.product ? item.product.itemName : item.itemName || 'Deleted Product'
                  td= item.specification || '-'
                  td= item.quantity || 0
                  td UGX #{item.unitPrice || 0}
                  td UGX #{item.itemTotal || 0}
            else
              tr
                td(colspan="5") No items found

      hr

      // ================= PAYMENT SUMMARY =================
      .summary-section
        h3 Payment Summary

        .summary-grid

          .summary-row
            span Total Amount
            strong UGX #{payment.amount || 0}

          .summary-row
            span Transport Cost
            strong UGX #{payment.transportCost || 0}

          .summary-row
            span Total To Pay
            strong UGX #{payment.totalToPay || 0}

          .summary-row
            span Amount Paid
            strong UGX #{payment.amountPaid || 0}

          .summary-row.balance
            span Balance
            strong UGX #{payment.balance || 0}

          .summary-row
            span Payment Method
            strong= payment.paymentMethod || '-'

      hr

      // ================= FOOTER =================
      .receipt-footer
        p Thank you for choosing NYONDO General Hardware LTD.
        p Goods are released after full payment clearance.

      // ================= PRINT =================
      .print-area
        button.print-btn(type="button" onclick="window.print()")
          | Print Receipt