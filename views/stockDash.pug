doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title NYONDO | Stock Manager Dashboard

    link(rel="stylesheet", href="/css/stockDash.css")

  body

    // ================= SIDEBAR =================
    aside.sidebar

      .sidebar-brand
        h2 NYONDO STOCK

      ul.sidebar-links

        li.active
          a(href="/stockDash")
            | 📊 Dashboard

        li
          a(href="/stockform")
            | ➕ Make New Stock

        li
          a(href="/supplierTable")
            | 💳 Supplier Table

        li
          a(href="/logout")
            | 🚪 Logout


    // ================= MAIN CONTENT =================
    .main-content

      nav.navbar

        .brand-container
          .logo-placeholder N

          .nav-brand-text
            strong NYONDO GENERAL HARDWARE
            span Quality Equipment • Nansana, Uganda

        .nav-right
          span.user-status Logged in as: Stock Manager
          span#live-time


      .container

        // ================= TOTAL STOCK VALUE (RECORDED ONLY) =================
        -
          let totalRecordedStockValue = 0

          if (allStocks && allStocks.length > 0) {
            allStocks.forEach(item => {
              const qty = Number(item.originalQuantity || item.quantity || 0)
              const cost = Number(item.unitCost || 0)
              totalRecordedStockValue += qty * cost
            })
          }

        // ================= DASHBOARD CARDS =================
        .stats-grid

          .stat-card
            h3 Total Items Recorded As Stock
            p #{allStocks ? allStocks.length : 0}

          .stat-card
            h3 Low Stock Alerts
            p #{lowStockCount || 0}

          .stat-card
            h3 Supplier Credits
            p #{supplierCredits ? supplierCredits.length : 0}

          .stat-card
            h3 Total Stock Value
            p UGX #{Number(totalRecordedStockValue).toLocaleString()}


        .main-layout

          // ================= LIVE STOCK (NO STOCK COST) =================
          .content-left

            .section-box
              h3 📦 Live Stock (Reduced By Sales & Deposits)

              .table-scroll
                table.stock-table

                  thead
                    tr
                      th Image
                      th Product Name
                      th Category
                      th Remaining Quantity
                      th Buying Price
                      th Selling Price
                      th Status

                  tbody

                    if !liveStocks || liveStocks.length === 0
                      tr
                        td(colspan="7")
                          | No live stock available

                    else
                      each item in liveStocks

                        -
                          const qty = Number(item.quantity || 0)
                          const buy = Number(item.unitCost || 0)
                          const sell = Number(item.unitPrice || 0)

                        tr

                          td
                            if item.productImage
                              img(
                                src=`/uploads/${item.productImage}`
                                style="width:60px;height:60px;object-fit:cover;border-radius:8px;"
                              )
                            else
                              span No Image

                          td
                            strong= item.itemName || "No Product"

                          td
                            = item.category || "General"

                          td
                            strong= qty

                          td
                            | UGX #{buy.toLocaleString()}

                          td
                            | UGX #{sell.toLocaleString()}

                          td
                            if qty <= 5
                              span.status-low LOW STOCK
                            else
                              span.status-ok AVAILABLE


          // ================= ALL STOCK RECORDS =================
          .content-right

            .section-box
              h3 🗂️ All Registered Stock Records

              .table-scroll
                table.stock-table

                  thead
                    tr
                      th Image
                      th Product Name
                      th Category
                      th Quantity Registered
                      th Buying Price
                      th Selling Price
                      th Stock Cost
                      th Supplier
                      th Attendant
                      th Date
                      th Actions

                  tbody

                    if !allStocks || allStocks.length === 0
                      tr
                        td(colspan="11")
                          | No stock records available

                    else
                      each item in allStocks

                        -
                          const qty = Number(item.originalQuantity || item.quantity || 0)
                          const buy = Number(item.unitCost || 0)
                          const sell = Number(item.unitPrice || 0)
                          const stockCost = qty * buy

                        tr

                          td
                            if item.productImage
                              img(
                                src=`/uploads/${item.productImage}`
                                style="width:60px;height:60px;object-fit:cover;border-radius:8px;"
                              )
                            else
                              span No Image

                          td
                            strong= item.itemName || "No Product"

                          td
                            = item.category || "General"

                          td
                            = qty

                          td
                            | UGX #{buy.toLocaleString()}

                          td
                            | UGX #{sell.toLocaleString()}

                          td
                            strong UGX #{stockCost.toLocaleString()}

                          td
                            = item.supplier || "-"

                          td
                            if item.Attendant && item.Attendant.fullName
                              strong= item.Attendant.fullName
                            else
                              | N/A

                          td
                            if item.createdAt
                              = new Date(item.createdAt).toDateString()
                            else
                              | -

                          td
                            a.btn.btn-blue(href=`/stock/edit/${item._id}`) Edit
                            a.btn.btn-gold(
                              href=`/stock/confirm/${item._id}`
                              onclick="return confirm('Confirm stock update?')"
                            ) Update
                            a.btn.btn-red(
                              href=`/stock/delete/${item._id}`
                              onclick="return confirm('Delete stock record?')"
                            ) Delete


    script.
      function updateClock() {
        const now = new Date();
        document.getElementById("live-time").innerText = now.toLocaleString();
      }

      setInterval(updateClock, 1000);
      updateClock();