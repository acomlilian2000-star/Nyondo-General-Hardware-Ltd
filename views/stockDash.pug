doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title NYONDO | Stock Manager Dashboard

    link(rel="stylesheet", href="/css/stockDash.css")

  body

    nav.navbar

      .brand-container

        .logo-placeholder
          | N

        .nav-brand-text
          strong NYONDO GENERAL HARDWARE
          span Quality Equipment • Nansana, Uganda

      .nav-right

        span.user-status
          | Logged in as: Stock Manager

        span#live-time

        button.logout-btn(onclick="handleLogout()")
          | LOGOUT

    .container

      .stats-grid

        .stat-card
          h3 Total Stock Items
          p #{stocks ? stocks.length : 0}

        .stat-card
          h3 Low Stock Alerts
          p #{lowStockCount || 0}

        .stat-card
          h3 Supplier Credits
          p #{supplierCredits ? supplierCredits.length : 0}

        .stat-card
          h3 Total Stock Value
          p UGX #{totalStockValue || 0}

      .main-layout

        .content-left

          .section-box

            h3 📦 New Stock Entries

            .table-scroll

              table.stock-table

                thead
                  tr
                    th Image
                    th Product Name
                    th Category
                    th Quantity
                    th Buying Price
                    th Selling Price
                    th Stock Cost
                    th Attendant
                    th Actions

                tbody

                  if !stocks || stocks.length === 0

                    tr
                      td(colspan="9")
                        | No new stock entries available

                  else

                    each item in stocks

                      -
                        const qty = item.quantity || 0
                        const buy = item.unitCost || 0
                        const sell = item.unitPrice || 0
                        const cost = qty * buy

                      tr

                        td

                          if item.productImage

                            img(
                              src=`/uploads/${item.productImage}`
                              alt="Product Image"
                              style="width:60px; height:60px; object-fit:cover; border-radius:8px;"
                            )

                          else

                            span No Image

                        td
                          strong= item.itemName || "No Product"

                        td
                          = item.category || "General"

                        td
                          = qty

                        td
                          | UGX #{buy}

                        td
                          | UGX #{sell}

                        td
                          | UGX #{cost}

                        td
                          strong= item.attendant || "N/A"

                        td

                          a.btn.btn-blue(
                            href=`/stock/edit/${item._id}`
                          )
                            | Edit

                          a.btn.btn-gold(
                            href=`/stock/confirm/${item._id}`
                            onclick="return confirm('Confirm stock update?')"
                          )
                            | Update

          .section-box

            h3 🗂️ Old Stock Records

            .table-scroll

              table.stock-table

                thead
                  tr
                    th Image
                    th Product Name
                    th Category
                    th Quantity
                    th Buying Price
                    th Selling Price
                    th Stock Cost
                    th Attendant
                    th Status

                tbody

                  if !oldStocks || oldStocks.length === 0

                    tr
                      td(colspan="9")
                        | No old stock records available

                  else

                    each item in oldStocks

                      -
                        const qty = item.quantity || 0
                        const buy = item.unitCost || 0
                        const sell = item.unitPrice || 0
                        const cost = qty * buy

                      tr

                        td

                          if item.productImage

                            img(
                              src=`/uploads/${item.productImage}`
                              alt="Old Stock Image"
                              style="width:60px; height:60px; object-fit:cover; border-radius:8px;"
                            )

                          else

                            span No Image

                        td
                          strong= item.itemName || "No Product"

                        td
                          = item.category || "General"

                        td
                          = qty

                        td
                          | UGX #{buy}

                        td
                          | UGX #{sell}

                        td
                          | UGX #{cost}

                        td
                          strong= item.attendant || "N/A"

                        td

                          if item.quantity <= 5
                            span.status-low Low Stock
                          else
                            span.status-ok Available

        .content-right

          .section-box

            h3 ⚡ Quick Actions

            .btn-grid

              button.btn.btn-blue(
                onclick="nav('/stockform')"
              )
                | ➕ Stock Registration

              button.btn.btn-gold(
                onclick="nav('/stockDash')"
              )
                | 🔄 Refresh Dashboard

              button.btn.btn-green(
                onclick="nav('/supplierTable')"
              )
                | 💳 Supplier Table

    script.

      function nav(url) {
        window.location.href = url;
      }

      function updateClock() {
        const now = new Date();
        document.getElementById("live-time").innerText =
          now.toLocaleString();
      }

      setInterval(updateClock, 1000);
      updateClock();

      function handleLogout() {
        if (confirm("Logout from dashboard?")) {
          window.location.href = "/logout";
        }
      }