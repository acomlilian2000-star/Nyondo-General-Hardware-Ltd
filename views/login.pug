doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title NYONDO | Staff Login
    link(rel="stylesheet", href="/css/login.css")

    style.
      /* Internal CSS for clean, high-contrast system validation banners */
      .alert-box {
        padding: 12px 16px;
        border-radius: 4px;
        margin-bottom: 20px;
        font-weight: bold;
        font-size: 14px;
        text-align: left;
      }
      .alert-success {
        background-color: #d1fae5;
        color: #065f46;
        border-left: 5px solid #10b981;
      }
      .alert-error {
        background-color: #fee2e2;
        color: #991b1b;
        border-left: 5px solid #ef4444;
      }

  body
    .page-wrapper

      .brand-header NYONDO GENERAL HARDWARE LTD

      section.login-card

        // ================= FLASH NOTIFICATIONS =================
        if success_msg && success_msg.length > 0
          .alert-box.alert-success
            | #{success_msg}

        if error_msg && error_msg.length > 0
          .alert-box.alert-error
            | #{error_msg}

        if error && error.length > 0
          .alert-box.alert-error
            | #{error}

        h2 Staff Login
        p Welcome back to the portal

        form(action="/login", method="post")

          .form-group
            label Email Address
            input(
              type="text"
              name="email"
              placeholder="name@company.com"
            )

          .form-group
            label Password
            input(
              type="password"
              name="password"
              placeholder="••••••••"
            )

          button.btn-login(type="submit")
            | Sign In

        //- a.forgot-password(href="/secureAcc") Change Password

        .footer-links
          | New staff member?
          a(href="/secureAcc") Contact Admin