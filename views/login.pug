doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title NYONDO | Staff Login
    link(rel="stylesheet", href="/css/login.css")

  body
    .page-wrapper

      .brand-header NYONDO GENERAL HARDWARE LTD

      section.login-card

        // ================= BACKEND ERROR DISPLAY =================
        if error
          .error-box
            p= error

        h2 Staff Login
        p Welcome back to the portal

        form(action="/login", method="post")

          .form-group
            label Email Address
            input(
              type="text"
              name="email"
              placeholder="name@company.com"
            )

          .form-group
            label Password
            input(
              type="password"
              name="password"
              placeholder="••••••••"
            )

          button.btn-login(type="submit")
            | Sign In

        //- a.forgot-password(href="/secureAcc") Change Password

        .footer-links
          | New staff member?
          a(href="/secureAcc") Contact Admin