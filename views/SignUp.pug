meta(charset="UTF-8")
meta(name="viewport", content="width=device-width,initial-scale=1")
title NYONDO | Staff Registration
link(rel="stylesheet", href="/css/signup.css")

.page-wrapper
  .brand-header.
    
    NYONDO GENERAL HARDWARE LTD
    
  section.signup-card

    // ================= BACKEND ERROR DISPLAY (ADDED) =================
    if error
      .error-box
        p= error

    h2 Staff Signup
    p Enter your details to register

    form(action="/SignUp" method="post")

      .form-group
        label Full Name
        input(type="text", name="fullName" placeholder="e.g. John Musoke")

      .form-group
        label Email Address
        input(type="text", name="email" placeholder="name@company.com")

      .form-group
        label NIN Number (14 Characters)
        input(type="text", name="ninNumber" placeholder="CM000000000000", style="text-transform: uppercase;")

      .form-group
        label Phone Number
        .phone-container
          span.phone-prefix +256
          input(type="text", name="phoneNumber" placeholder="770000000")

      // ✅ ROLE SECTION ADDED HERE (NO CHANGES ELSEWHERE)
      .form-group
        label User Role
        select(name="role")
          option(value="") -- Select Role --
          option(value="admin") Admin
          option(value="stock_manager") Stock Manager
          option(value="sales_attendant") Sales Attendant

      .form-group
        label Residential Address
        input(type="text", name="address" placeholder="Nansana, Wakiso")

      .form-group
        label Password

        // password rule hint (frontend guidance only)
        small.password-hint Password must be at least 8 characters with letters and numbers

        input(type="password", name="password" placeholder="••••••••")

      button.btn-submit(type="submit") Create Account

    //- .footer-text
