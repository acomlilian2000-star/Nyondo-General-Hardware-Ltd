doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")

    title NYONDO | Staff Registration

    link(rel="stylesheet", href="/css/signup.css")

    style.
      /* Internal CSS for clean, high-contrast system validation banners */
      .alert-box {
        padding: 12px 16px;
        border-radius: 4px;
        margin-bottom: 20px;
        font-weight: bold;
        font-size: 14px;
        text-align: left;
      }
      .alert-success {
        background-color: #d1fae5;
        color: #065f46;
        border-left: 5px solid #10b981;
      }
      .alert-error {
        background-color: #fee2e2;
        color: #991b1b;
        border-left: 5px solid #ef4444;
      }

  body

    .page-wrapper

      .brand-header
        | NYONDO GENERAL HARDWARE LTD

      section.signup-card

        // ================= FLASH NOTIFICATIONS =================
        if success_msg && success_msg.length > 0
          .alert-box.alert-success
            | #{success_msg}

        if error_msg && error_msg.length > 0
          .alert-box.alert-error
            | #{error_msg}

        if error && error.length > 0
          .alert-box.alert-error
            | #{error}

        h2 Staff Signup

        p Enter your details to register

        form(action="/SignUp" method="post")

          .form-group
            label(for="fullName") Full Name

            input(
              type="text"
              id="fullName"
              name="fullName"
              placeholder="e.g. John Musoke"
            )

          .form-group
            label(for="email") Email Address

            input(
              type="text"
              id="email"
              name="email"
              placeholder="name@company.com"
            )

          .form-group
            label(for="ninNumber") NIN Number (14 Characters)

            input(
              type="text"
              id="ninNumber"
              name="ninNumber"
              placeholder="CM000000000000"
              style="text-transform: uppercase;"
            )

          .form-group
            label(for="phoneNumber") Phone Number

            .phone-container

              span.phone-prefix +256

              input(
                type="text"
                id="phoneNumber"
                name="ugPhoneNumber"
                placeholder="770000000"
              )

          // ================= ROLE SECTION =================
          .form-group
            label(for="role") User Role

            select(
              id="role"
              name="role"
            )
              option(value="") -- Select Role --
              option(value="admin") Admin
              option(value="stock_manager") Stock Manager
              option(value="sales_attendant") Sales Attendant

          .form-group
            label(for="address") Residential Address

            input(
              type="text"
              id="address"
              name="address"
              placeholder="Nansana, Wakiso"
            )

          .form-group
            label(for="password") Password

            small.password-hint
              | Password must be at least 8 characters with letters and numbers

            input(
              type="password"
              id="password"
              name="password"
              placeholder="••••••••"
            )

          button.btn-submit(type="submit")
            | Create Account

        //- .footer-text
        //-   |
        //-   Already registered?
        //-   a(href="/login") Login Here