meta(charset="UTF-8")
meta(name="viewport", content="width=device-width,initial-scale=1")
title NYONDO | Secure Your Account
link(rel="stylesheet", href="/css/secureAcc.css")
.page-wrapper
  .brand-header.
    
    NYONDO GENERAL HARDWARE LTD
    
  section.secure-card
    h2 Account Security
    p Verify your identity and set a strong password.
    form#secureForm(action="/secureAcc" method="post")
      //  Email Verification 
      .form-group
        label Confirm Registered Email
        input#userEmail(type="email",name="email" placeholder="name@company.com", required)
      //  Temporal Password 
      .form-group
        label Temporal Password
        input#tempPass(type="password", name="password" placeholder="Enter password sent to you", required)
      hr
      //  New Password 
      .form-group
        label New Permanent Password
        input#newPass(type="password",name="password" placeholder="••••••••", required)
      //  Password Checklist 
      .requirements-box
        .req-item#len ○ Minimum 8 characters
        .req-item#num ○ Contains a number
        .req-item#spec ○ Contains special character (!@#$)
      //  Confirm Password 
      .form-group
        label Confirm Permanent Password
        input#confirmPass(type="password",name="password" placeholder="••••••••", required)
      button.btn-update(type="submit") Secure Account & Login
script.
  
  const newPassInput = document.getElementById('newPass');
          const reqs = {
              len: document.getElementById('len'),
              num: document.getElementById('num'),
              spec: document.getElementById('spec')
          };
  
          newPassInput.addEventListener('input', () => {
              const val = newPassInput.value;
              
              // Check Length
              val.length >= 8 ? reqs.len.classList.add('met') : reqs.len.classList.remove('met');
              val.length >= 8 ? reqs.len.innerText = '● Minimum 8 characters' : reqs.len.innerText = '○ Minimum 8 characters';
  
              // Check Number
              /[0-9]/.test(val) ? reqs.num.classList.add('met') : reqs.num.classList.remove('met');
              /[0-9]/.test(val) ? reqs.num.innerText = '● Contains a number' : reqs.num.innerText = '○ Contains a number';
  
              // Check Special
              /[!@#$%^&*]/.test(val) ? reqs.spec.classList.add('met') : reqs.spec.classList.remove('met');
              /[!@#$%^&*]/.test(val) ? reqs.spec.innerText = '● Contains special character (!@#$)' : reqs.spec.innerText = '○ Contains special character (!@#$)';
          });
  
          document.getElementById('secureForm').onsubmit = (e) => {
              e.preventDefault();
              const p1 = newPassInput.value;
              const p2 = document.getElementById('confirmPass').value;
  
              if (p1 !== p2) {
                  alert("The new passwords do not match. Please check again.");
                  return;
              }
  
              alert("Security update complete. Welcome to the NYONDO Management System.");
          };
  