doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Supplier Credit Table

    link(rel="stylesheet", href="/css/stockDash.css")

  body

    nav.navbar
      .brand-container
        .logo-placeholder N
        .nav-brand-text
          strong NYONDO GENERAL HARDWARE
          span Supplier Credit Management

      .nav-right
        button.logout-btn(onclick="goBack()") BACK

    .container

      .section-box
        h3 💳 Supplier Credit Summary

        .table-scroll
          table.credit-table

            thead
              tr
                th Supplier
                th Contact
                th Phone
                th Factory
                th Items Supplied
                th Quantity Supplied
                th Supplied Date
                th Total Amount Owed
                th Status
                th Actions

            tbody

              if !supplierCredits || supplierCredits.length === 0
                tr
                  td(colspan="10") No supplier credits available

              else
                each credit in supplierCredits
                  tr

                    td
                      strong= credit.supplier || "-"

                    td
                      = credit.contactPerson || "-"

                    td
                      | +256 #{credit.supplierPhone || "-"}

                    td
                      = credit.factoryName || "-"

                    td
                      ul
                        if credit.items && credit.items.length
                          each item in credit.items
                            li= item
                        else
                          li No items recorded

                    // ✅ NEW COLUMN: TOTAL QUANTITY
                    td
                      strong= credit.totalQuantity || 0

                    td
                      = credit.suppliedDate ? new Date(credit.suppliedDate).toDateString() : "-"

                    td
                      strong
                        | UGX #{(credit.totalAmount || 0).toLocaleString()}

                    td
                      span.status-low Pending

                    td
                      if credit.supplier
                        a.btn.btn-green(
                          href=`/supplier/mark-paid/${credit.supplier}`
                          onclick="return confirm('Mark supplier as PAID?')"
                        )
                          | Mark Paid

                        a.btn.btn-red(
                          href=`/supplier/clear/${credit.supplier}`
                          onclick="return confirm('Clear supplier record?')"
                        )
                          | Clear

    script.
      function goBack() {
        window.location.href = "/stockDash";
      }