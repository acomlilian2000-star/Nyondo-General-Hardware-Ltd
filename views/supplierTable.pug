doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Supplier Table

    link(rel="stylesheet", href="/css/stockDash.css")

  body

    nav.navbar
      .brand-container
        .logo-placeholder N
        .nav-brand-text
          strong NYONDO GENERAL HARDWARE
          span Supplier Management

      .nav-right
        button.logout-btn(onclick="goBack()") BACK


    .container

      .section-box
        h3 🏢 Supplier Table

        .table-scroll
          table.credit-table

            thead
              tr
                th Supplier
                th Contact
                th Phone
                th Factory
                th Items Supplied
                th Quantity Supplied
                th Supplied Date
                th Total Amount
                th Status
                th Actions

            tbody

              if !supplierCredits || supplierCredits.length === 0
                tr
                  td(colspan="10") No suppliers available

              else
                each supplier in supplierCredits
                  tr

                    td strong= supplier.supplier
                    td= supplier.contactPerson
                    td | +256 #{supplier.supplierPhone}
                    td= supplier.factoryName

                    td
                      ul
                        each item in supplier.items
                          li= item

                    td strong= supplier.totalQuantity || 0
                    td= supplier.date ? new Date(supplier.date).toDateString() : "-"

                    td strong UGX #{Number(supplier.totalAmount || 0).toLocaleString()}

                    td
                      span.status-pending PENDING

                    td
                      a.btn.btn-green(
                        href=`/supplier/mark-paid/${supplier._id || supplier.supplier}`
                        onclick="return confirm('Mark supplier as PAID?')"
                      ) Mark Paid

    script.
      function goBack() {
        window.location.href = "/stockDash";
      }