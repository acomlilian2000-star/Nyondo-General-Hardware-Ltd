doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Salary Earner Scheme - NYONDO

    link(rel="stylesheet", href="/css/salaryScheme.css")

  body

    .container

      header
        h1 NYONDO General Hardware LTD
        span.scheme-badge Salary Earner Deposit Scheme Portal

      form#salaryForm(action="#" method="POST")

        h3 1. Member Registration

        .form-grid

          .input-group
            label Full Name *
            input(type="text" name="customerName" required)

          .input-group
            label NIN Number *
            input#ninNumber(
              type="text"
              name="ninNumber"
              maxlength="14"
              minlength="14"
              required
            )

          .input-group
            label Phone Number *
            .phone-wrapper
              span.prefix +256
              input(type="tel" name="customerPhone" maxlength="9" required)

          .input-group
            label Date of Registration
            input(type="date" name="regDate" required)

        h3 2. Items

        .notice-box
          | Deposits limited to Cement, Iron Bars, Iron Sheets

        table
          thead
            tr
              th Item
              th Specification
              th Qty
              th Unit Price
              th Total

          tbody#itemsBody
            tr.itemRow
              td
                select.productSelect(name="itemName" required)
                  option(value="") Select Item
                  option Cement
                  option Iron Bars
                  option Iron Sheets

              td
                select.specification(name="specification")

              td
                input.quantity(type="number" name="quantity" min="1")

              td
                input.unitPrice(type="number" name="unitPrice")

              td
                input.itemTotal(type="number" name="itemTotal" readonly)

        button#addItemBtn.add-btn(type="button") + Add Item

        h3 Payment Summary

        .form-grid

          .input-group
            label Total
            input#grandTotal(type="number" name="grandTotal" readonly)

          .input-group
            label Distance KM
            input#distance(type="number" name="distance")

          .input-group
            label Transport
            input#transportCost(type="number" name="transportCost" readonly)

          .input-group
            label Total To Pay
            input#totalToPay(type="number" name="totalToPay" readonly)

          .input-group
            label Amount Paid
            input#amountPaid(type="number" name="amountPaid")

          .input-group
            label Balance
            input#balance(type="number" name="balance" readonly)

          .input-group
            label Payment Method
            select(name="paymentMethod")
              option Bank
              option Mobile Money
              option Cash

        .print-area
          button.btn-print(type="button" onclick="printReceipt()")
            | PRINT RECEIPT

    script
    // NIN uppercase + limit
document.getElementById("ninNumber").addEventListener("input", function () {
  this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, "").slice(0, 14);
});

// specifications
const specs = {
  "Cement": ["CEM II", "CEM III"],
  "Iron Bars": ["10mm", "12mm", "16mm"],
  "Iron Sheets": ["Gauge 28", "Gauge 30"]
};

// update specs
function updateSpecs(row) {
  const product = row.querySelector(".productSelect").value;
  const spec = row.querySelector(".specification");

  spec.innerHTML = "";

  if (specs[product]) {
    specs[product].forEach(s => {
      const opt = document.createElement("option");
      opt.value = s;
      opt.textContent = s;
      spec.appendChild(opt);
    });
  }
}

// row total
function calcRow(row) {
  const qty = Number(row.querySelector(".quantity").value) || 0;
  const price = Number(row.querySelector(".unitPrice").value) || 0;

  row.querySelector(".itemTotal").value = qty * price;
  calcGrand();
}

// grand total
function calcGrand() {
  let total = 0;

  document.querySelectorAll(".itemRow").forEach(r => {
    total += Number(r.querySelector(".itemTotal").value) || 0;
  });

  document.getElementById("grandTotal").value = total;
  calcTransport();
}

// transport logic
function calcTransport() {
  const total = Number(document.getElementById("grandTotal").value) || 0;
  const distance = Number(document.getElementById("distance").value) || 0;

  let transport = 30000;

  if (total >= 500000 && distance <= 10 && distance > 0) {
    transport = 0;
  }

  document.getElementById("transportCost").value = transport;

  document.getElementById("totalToPay").value = total + transport;

  calcBalance();
}

// balance
function calcBalance() {
  const total = Number(document.getElementById("totalToPay").value) || 0;
  const paid = Number(document.getElementById("amountPaid").value) || 0;

  document.getElementById("balance").value = total - paid;
}

// add row
document.getElementById("addItemBtn").addEventListener("click", () => {
  const row = document.querySelector(".itemRow");
  const clone = row.cloneNode(true);

  clone.querySelectorAll("input").forEach(i => i.value = "");
  clone.querySelectorAll("select").forEach(s => s.selectedIndex = 0);

  document.getElementById("itemsBody").appendChild(clone);
});

// events
document.addEventListener("change", e => {
  const row = e.target.closest(".itemRow");
  if (!row) return;

  if (e.target.classList.contains("productSelect")) {
    updateSpecs(row);
  }

  if (e.target.classList.contains("quantity") ||
      e.target.classList.contains("unitPrice")) {
    calcRow(row);
  }
});

document.addEventListener("input", e => {
  const row = e.target.closest(".itemRow");
  if (!row) return;

  if (e.target.classList.contains("quantity") ||
      e.target.classList.contains("unitPrice")) {
    calcRow(row);
  }
});

document.getElementById("distance").addEventListener("input", calcTransport);
document.getElementById("amountPaid").addEventListener("input", calcBalance);

// print
function printReceipt() {
  window.print();
}